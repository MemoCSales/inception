# This file will contain the basic configuration settings for your MariaDB server.

[mysqld]
user			= mysql
pid-file		= /run/mysqld/mysqld.pid
socket			= /run/mysqld/mysqld.sock
port			= 3306
basedir			= /usr
datadir			= /var/lib/mysql
tmpdir			= /tmp
bind-address	= 0.0.0.0

symbolic-links	= 0

skip-networking	= false